#define MyAppName "InputLeap"
#define MyAppVersion "@INPUTLEAP_VERSION_MAJOR@.@INPUTLEAP_VERSION_MINOR@.@INPUTLEAP_VERSION_PATCH@"
#define MyAppTextVersion "@INPUTLEAP_VERSION@"
#define MyAppPublisher "InputLeap contributors"
#define MyAppURL "https://github.com/input-leap/input-leap/wiki"
#define MyAppCopyright "Copyright (C) InputLeap contributors"
#define MyAppExeName "input-leap-tauri.exe"
#define MyAppServiceName "InputLeap"
#define MyAppServiceExe "input-leapd.exe"
#define MyAppServiceDesc "Manages the InputLeap background processes."
#define MyDnsSdServiceName "Bonjour Service"
#define MyDnsSdServiceExe "mDNSResponder.exe"
#define MyDnsSdMarkerKey "Software\InputLeap\Installer"
#define MyDnsSdMarkerValue "ManagedDnsSdService"
#define MyAppListenerDesc "InputLeap Listener"
#define MyAppFileTransferDesc "InputLeap File Transfer"

[Setup]
AppId={{41036EA6-3F7A-4803-8AE0-46912391EFCC}
AppName={#MyAppName}
AppVersion={#MyAppTextVersion}
AppVerName={#MyAppName} {#MyAppTextVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DisableProgramGroupPage=yes
LicenseFile=@CMAKE_CURRENT_SOURCE_DIR@/res/License.rtf
OutputDir=@CMAKE_INSTALL_PREFIX@/../installer-inno/bin
OutputBaseFilename=InputLeapSetup-{#MyAppTextVersion}
SetupIconFile=@CMAKE_CURRENT_SOURCE_DIR@/res/input-leap.ico
VersionInfoProductTextVersion={#MyAppTextVersion}
VersionInfoProductVersion={#MyAppVersion}
VersionInfoTextVersion={#MyAppTextVersion}
VersionInfoVersion={#MyAppVersion}
VersionInfoCopyright={#MyAppCopyright}

Compression=lzma
SolidCompression=yes
ArchitecturesInstallIn64BitMode=x64compatible
UninstallDisplayIcon={app}\{#MyAppExeName}

#include "scripts\lang\english.iss"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "@CMAKE_INSTALL_PREFIX@/dnssd.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "@CMAKE_INSTALL_PREFIX@/mDNSResponder.exe"; DestDir: "{app}"; Flags: ignoreversion; BeforeInstall: StopManagedDnsSdService; AfterInstall: InstallManagedDnsSdService
Source: "@CMAKE_INSTALL_PREFIX@/*"; DestDir: "{app}"; Excludes: "dnssd.dll,mDNSResponder.exe"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "@CMAKE_CURRENT_SOURCE_DIR@/LICENSE"; DestDir: "{app}"; DestName: "LICENSE.txt"; Flags: ignoreversion
Source: "@CMAKE_CURRENT_SOURCE_DIR@/res/License.rtf"; DestDir: "{app}"; DestName: "License.rtf"; Flags: ignoreversion
Source: "@CMAKE_CURRENT_SOURCE_DIR@/THIRD_PARTY_NOTICES.md"; DestDir: "{app}"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{commonprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
; there's no "check if exists" or "insert if not exists" for netsh's firewall commands
; to avoid duplicate entries remove the existing rule (fails if it doesn't exist) before adding
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall delete rule name=""{#MyAppListenerDesc}"""; Flags: runhidden
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall delete rule name=""{#MyAppFileTransferDesc}"""; Flags: runhidden
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall add rule name=""{#MyAppListenerDesc}"" protocol=TCP dir=in localport=24800 remoteip=localsubnet,100.64.0.0/10 action=allow"; Flags: runhidden
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall add rule name=""{#MyAppFileTransferDesc}"" protocol=TCP dir=in localport=24810 remoteip=localsubnet,100.64.0.0/10 action=allow"; Flags: runhidden
Filename: {sys}\sc.exe; Parameters: "create {#MyAppServiceName} start= auto binPath= ""\""{app}\{#MyAppServiceExe}\"""""; Flags: runhidden; Check: not IsInputLeapServiceInstalled
Filename: {sys}\sc.exe; Parameters: "config {#MyAppServiceName} start= auto binPath= ""\""{app}\{#MyAppServiceExe}\"""""; Flags: runhidden; Check: IsInputLeapServiceInstalled
Filename: {sys}\sc.exe; Parameters: "description {#MyAppServiceName} ""{#MyAppServiceDesc}"""; Flags: runhidden
Filename: {sys}\sc.exe; Parameters: "start {#MyAppServiceName}"; Flags: runhidden
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
Filename: {sys}\taskkill; Parameters: "/im {#MyAppExeName} /f /t"; Flags: runhidden; RunOnceId: "StopInputLeapGui"
Filename: {sys}\net.exe; Parameters: "stop {#MyAppServiceName}"; Flags: runhidden; RunOnceId: "StopInputLeapService"
Filename: {sys}\sc.exe; Parameters: "delete {#MyAppServiceName}"; Flags: runhidden; RunOnceId: "DeleteInputLeapService"
Filename: "{app}\{#MyDnsSdServiceExe}"; Parameters: "-remove"; Flags: runhidden waituntilterminated; RunOnceId: "RemoveInputLeapManagedDnsSdService"; Check: IsInputLeapManagedDnsSdService
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall delete rule name=""{#MyAppListenerDesc}"""; Flags: runhidden; RunOnceId: "DeleteInputLeapListenerFirewallRule"
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall delete rule name=""{#MyAppFileTransferDesc}"""; Flags: runhidden; RunOnceId: "DeleteInputLeapFileTransferFirewallRule"

[CustomMessages]
DependenciesDir="redist"

; shared code for installing the products
#include "scripts\products.iss"
#include "scripts\products\stringversion.iss"
#include "scripts\products\winversion.iss"
#include "scripts\products\msiproduct.iss"
#include "scripts\products\vcredist2017.iss"

[Code]
function IsInputLeapServiceInstalled(): boolean;
var
	ResultCode: Integer;
begin
	ResultCode := -1;
	Result := Exec(ExpandConstant('{sys}\sc.exe'), 'query {#MyAppServiceName}', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

function IsDnsSdServiceInstalled(): boolean;
begin
	Result := RegKeyExists(HKLM, 'SYSTEM\CurrentControlSet\Services\{#MyDnsSdServiceName}');
end;

function IsInputLeapManagedDnsSdService(): boolean;
var
	Managed: string;
begin
	Result := RegQueryStringValue(HKLM, '{#MyDnsSdMarkerKey}', '{#MyDnsSdMarkerValue}', Managed) and (Managed = '1');
end;

procedure StopManagedDnsSdService();
var
	ResultCode: Integer;
begin
	if IsInputLeapManagedDnsSdService() and IsDnsSdServiceInstalled() then
		Exec(ExpandConstant('{sys}\net.exe'), 'stop "{#MyDnsSdServiceName}"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
end;

procedure InstallManagedDnsSdService();
var
	ResultCode: Integer;
begin
	if IsInputLeapManagedDnsSdService() or not IsDnsSdServiceInstalled() then
	begin
		if IsDnsSdServiceInstalled() then
		begin
			if not Exec(ExpandConstant('{sys}\net.exe'), 'start "{#MyDnsSdServiceName}"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
				RaiseException('Could not launch the bundled DNS-SD service start command after upgrade.');
			if ResultCode <> 0 then
				RaiseException(Format('Could not restart the InputLeap-managed DNS-SD service after upgrade (exit code %d).', [ResultCode]));
		end
		else
		begin
			if not Exec(ExpandConstant('{app}\{#MyDnsSdServiceExe}'), '-install', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
				RaiseException('Could not launch the bundled DNS-SD service installer.');
			if ResultCode <> 0 then
				RaiseException(Format('DNS-SD service installation failed with exit code %d.', [ResultCode]));
		end;
		if not IsDnsSdServiceInstalled() then
			RaiseException('The DNS-SD service did not register after installation.');
		if not RegWriteStringValue(HKLM, '{#MyDnsSdMarkerKey}', '{#MyDnsSdMarkerValue}', '1') then
			RaiseException('Could not record ownership of the DNS-SD service installed by InputLeap.');
	end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
	if (CurUninstallStep = usPostUninstall) and IsInputLeapManagedDnsSdService() then
		RegDeleteValue(HKLM, '{#MyDnsSdMarkerKey}', '{#MyDnsSdMarkerValue}');
end;

function InitializeSetup(): boolean;
var
	ResultCode: Integer;
begin
	// initialize windows version
	initwinversion();

	vcredist2017('14'); // min allowed version is 14.0

	// Stop an existing runtime before replacing its binaries during an upgrade.
	if IsInputLeapServiceInstalled() then
		Exec(ExpandConstant('{sys}\net.exe'), 'stop {#MyAppServiceName}', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);

	Result := true;
end;
