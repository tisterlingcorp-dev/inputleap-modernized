Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  performance-*,
  portability-*,
  modernize-use-nullptr,
  modernize-use-override,
  readability-container-size-empty
WarningsAsErrors: ''
HeaderFilterRegex: '(^|/)src/'
FormatStyle: file
CheckOptions:
  readability-identifier-naming.IgnoreMainLikeFunctions: '1'
